#include <stdio.h>

int main()
{
    int n, i, j;
    float capacity, profit[20], weight[20], ratio[20], x[20], total = 0;
    int idx[20], t;

    printf("Enter number of items: ");
    scanf("%d", &n);

    for (i = 0; i < n; i++)
    {
        printf("Enter profit and weight of item %d: ", i + 1);
        scanf("%f %f", &profit[i], &weight[i]);
        ratio[i] = profit[i] / weight[i];
        idx[i] = i;
    }

    printf("Enter capacity of knapsack: ");
    scanf("%f", &capacity);

    for (i = 0; i < n - 1; i++)
    {
        for (j = 0; j < n - i - 1; j++)
        {
            if (ratio[idx[j]] < ratio[idx[j + 1]])
            {
                t = idx[j];
                idx[j] = idx[j + 1];
                idx[j + 1] = t;
            }
        }
    }

    for (i = 0; i < n; i++)
        x[i] = 0;

    for (i = 0; i < n; i++)
    {
        int k = idx[i];

        if (weight[k] <= capacity)
        {
            x[k] = 1;
            capacity = capacity - weight[k];
            total = total + profit[k];
        }
        else
        {
            x[k] = capacity / weight[k];
            total = total + x[k] * profit[k];
            capacity = 0;
            break;
        }
    }

    printf("\nFractions taken:\n");

    for (i = 0; i < n; i++)
        printf("Item %d : %.2f\n", i + 1, x[i]);

    printf("Maximum profit = %.2f\n", total);

    return 0;
}