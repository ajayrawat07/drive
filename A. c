#include <stdio.h>
#include <string.h>

int main()
{
    char text[200], pattern[50];

    int n, m, i, j, found = 0;

    printf("Enter the text: ");
    scanf("%199s", text);

    printf("Enter the pattern: ");
    scanf("%49s", pattern);

    n = strlen(text);
    m = strlen(pattern);

    // Naive String Matching Algorithm
    for (i = 0; i <= n - m; i++)
    {
        for (j = 0; j < m; j++)
        {
            if (text[i + j] != pattern[j])
                break;
        }

        if (j == m)
        {
            printf("Pattern found at position %d\n", i);
            found = 1;
        }
    }

    if (!found)
    {
        printf("Pattern not found\n");
    }

    return 0;
}